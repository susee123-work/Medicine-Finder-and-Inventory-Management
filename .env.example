# MediPulse AI Environment Configuration
# Copy this to .env: cp .env.example .env

ENV=development
DEBUG=true

# Supabase (Optional for local testing; if omitted, in-memory repository is used)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
USE_LOCAL_DB=false

# Security & Authentication
JWT_SECRET=medipulse-ai-dev-secret-key-change-in-prod-2026
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
RATE_LIMIT_PUBLIC=60/minute

# Notification Services (Twilio SMS & Resend Email)
MOCK_NOTIFICATIONS=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
RESEND_API_KEY=
